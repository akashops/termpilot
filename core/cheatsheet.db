# SmartShell Enterprise Command Database
# Format: command|category|description|example_usage
ls|File System|List directory contents with details and colors|ls -la --color=auto
ll|File System|List directory contents in long format with human-readable sizes|ll -h
la|File System|List all files including hidden dotfiles|la -la
cd|Navigation|Change the current working directory|cd /var/log or cd ~
pwd|Navigation|Print current working directory absolute path|pwd -P
cp|File Management|Copy files and directories recursively with progress|cp -rv source/ destination/
mv|File Management|Move or rename files and directories atomically|mv -v old_name new_name
rm|File Management|Remove files or directories recursively|rm -rf /path/to/target
mkdir|File Management|Create new directories and parent structures|mkdir -p /opt/app/releases
rmdir|File Management|Remove empty directories safely|rmdir directory_name
touch|File Management|Create empty file or update file timestamps|touch config.yaml
cat|Text Processing|Concatenate and display file content with line numbers|cat -n /etc/hosts
tac|Text Processing|Display file contents in reverse order (bottom to top)|tac /var/log/syslog
less|Text Processing|View large file content page by page with live follow (Shift+F)|less +F /var/log/nginx/access.log
more|Text Processing|Filter for paging through text one screenful at a time|more file.txt
head|Text Processing|Output the first N lines of files|head -n 25 error.log
tail|Text Processing|Output the last part of files / follow live stream|tail -f -n 100 /var/log/messages
grep|Text Search|Search text patterns using regular expressions recursively|grep -rnI "CRITICAL" /var/log/
egrep|Text Search|Extended grep for multi-pattern regex matching|egrep -i "(error|fatal|exception)" app.log
fgrep|Text Search|Ultra-fast fixed-string search without regex overhead|fgrep -F "192.168.1.100" access.log
sed|Stream Editor|Non-interactive stream editor for search and replace in-place|sed -i 's/PORT=80/PORT=8080/g' .env
awk|Data Processing|Powerful pattern scanning and data extraction language|awk -F':' '{print $1, $3, $6}' /etc/passwd
cut|Text Processing|Extract specific byte, character or delimited fields|cut -d',' -f1,3 data.csv
sort|Data Processing|Sort lines of text files numerically or alphabetically|sort -k2 -n -r metrics.txt
uniq|Data Processing|Filter or count adjacent duplicate lines|sort access.log | uniq -c | sort -nr
wc|Text Metrics|Count lines, words, characters and byte sizes|wc -l /var/log/auth.log
tr|Stream Editor|Translate, squeeze or delete characters from standard input|cat file.txt | tr '[:lower:]' '[:upper:]'
diff|File Analysis|Compare files or directories line by line|diff -u config.orig config.new
colordiff|File Analysis|Colorized version of diff for clear visual comparison|colordiff -u file1.txt file2.txt
patch|File Management|Apply a diff file to an original to update it|patch -p1 < update.patch
find|File Search|Search for files by name, size, time, and permissions|find /var/log -type f -name "*.log" -mtime +30 -delete
locate|File Search|Find files instantaneously via pre-indexed mlocate database|locate -i nginx.conf
which|Environment|Locate an executable binary in user PATH|which python3
whereis|Environment|Locate binary, source code, and man pages for command|whereis nginx
type|Shell Builtin|Display information about command type (alias/builtin/file)|type -a ls
chmod|Permissions|Change file access permissions and special modes (SUID/SGID)|chmod 750 script.sh
chown|Permissions|Change owner and group ownership recursively|chown -R www-data:www-data /var/www/
chgrp|Permissions|Change group ownership of files|chgrp -R staff /opt/shared/
umask|Permissions|Set default file mode creation permissions mask|umask 027
chattr|File Attributes|Change extended file attributes (e.g. immutable lock)|chattr +i /etc/resolv.conf
lsattr|File Attributes|List file attributes on an ext2/ext3/ext4 file system|lsattr /etc/resolv.conf
ps|Processes|Snapshot of current active processes with resource consumption|ps aux --sort=-%mem | head -n 10
top|Monitoring|Dynamic real-time dashboard of system processes and CPU/RAM|top -b -n 1
htop|Monitoring|Interactive ncurses process manager and thread tree viewer|htop
btop|Monitoring|Modern terminal resource monitor with graph visualizations|btop
glances|Monitoring|Cross-platform curses-based full-system monitoring tool|glances
kill|Processes|Send process signals (e.g. SIGTERM=15, SIGKILL=9, SIGHUP=1)|kill -9 <PID>
killall|Processes|Kill all processes matching executable name|killall -TERM nginx
pkill|Processes|Signal processes matching full command line regex|pkill -9 -f "gunicorn: worker"
pgrep|Processes|List process IDs matching command name and attributes|pgrep -fa "node index.js"
pidof|Processes|Find the process ID of a running program|pidof mysqld
fuser|Processes|Identify processes using specific files, ports or sockets|fuser -k 8080/tcp
lsof|System Audit|List all open files, sockets, network connections, and pipes|lsof -iTCP:443 -sTCP:LISTEN
df|Disk Management|Report file system disk usage with inode and filesystem type|df -hT
du|Disk Management|Estimate disk space usage per directory sorted by size|du -sh * | sort -hr | head -n 10
ncdu|Disk Management|Interactive NCurses disk usage analyzer with fast deletion|ncdu /var
lsblk|Storage|List detailed block device hierarchy and mount points|lsblk -f
fdisk|Storage|Manipulate disk partition table (MBR/GPT)|fdisk -l /dev/sda
parted|Storage|GNU partition manipulation tool supporting partitions >2TB|parted /dev/nvme0n1 print
blkid|Storage|Locate and print block device attributes and UUIDs|blkid
mount|Storage|Mount a filesystem or storage block device to mountpoint|mount -o noatime,nodiratime /dev/sdb1 /data
umount|Storage|Unmount mounted filesystems safely|umount -l /mnt/backup
tune2fs|Storage|Adjust tunable filesystem parameters on ext4 filesystems|tune2fs -l /dev/sda1
fsck|Storage|Check and repair Linux file system integrity|fsck -fy /dev/sdb1
smartctl|Hardware|Control and query SMART attributes of NVMe/SSD/HDD health|smartctl -H -A /dev/nvme0n1
free|Memory|Display total, used, free, cache, and swap memory in human-readable|free -m -h
vmstat|Memory|Report virtual memory statistics, paging, CPU activity|vmstat 1 5
iostat|Performance|Report CPU statistics and input/output statistics for devices|iostat -xz 1 5
mpstat|Performance|Report individual CPU core utilization statistics|mpstat -P ALL 1 3
sar|Performance|Collect, report, and save system activity metrics|sar -u 1 5
systemctl|Systemd|Control the systemd system and service manager|systemctl status/restart/enable nginx
journalctl|Logging|Query and tail systemd journal logs by unit or priority|journalctl -u docker.service -f -n 100 --no-pager
service|Init System|Run a System V init script or legacy service manager|service apache2 status
sysctl|Kernel Tuning|Configure and load Linux kernel parameters at runtime|sysctl -p /etc/sysctl.conf
dmesg|Kernel|Examine and print kernel ring buffer logs and hardware events|dmesg -T --level=err,warn
lsmod|Kernel|Show loaded kernel modules status|lsmod | grep kvm
modprobe|Kernel|Add or remove modules from the Linux Kernel dynamically|modprobe overlay
uname|System Info|Print operating system kernel name, version, and architecture|uname -a
hostnamectl|System Info|Query and change system hostname and deployment details|hostnamectl status
uptime|System Info|Display system uptime, number of users and load average (1, 5, 15m)|uptime -p
neofetch|System Info|Fast visual system information CLI tool with distribution logo|neofetch
inxi|System Info|Comprehensive system and hardware information generator|inxi -Fxz
lscpu|Hardware|Display detailed information about CPU architecture and cores|lscpu
lspci|Hardware|List all PCI buses and connected devices (GPU, NIC, RAID)|lspci -nnk
lsusb|Hardware|List USB controllers and connected USB devices|lsusb -v
dmidecode|Hardware|DMI table decoder for BIOS, motherboard, RAM slots|dmidecode -t 17
ip|Networking|Modern tool to configure IP addresses, routes, interfaces, ARP|ip -br a or ip route show
ifconfig|Networking|Legacy interface configuration tool|ifconfig -a
route|Networking|Show or manipulate IP routing table (legacy)|route -n
netstat|Networking|Print network connections, routing tables, listening ports|netstat -tulnp
ss|Networking|Ultra-fast socket statistics utility for TCP/UDP inspection|ss -tulwnp
ping|Networking|Send ICMP echo request packets to verify network reachability|ping -c 4 -i 0.2 1.1.1.1
traceroute|Networking|Trace the route packets take to network host|traceroute -n -T -p 443 google.com
mtr|Networking|Interactive real-time network diagnostic tool combining ping and traceroute|mtr -rw 8.8.8.8
dig|DNS|Flexible DNS lookup tool to query domain records (A, MX, TXT, NS)|dig +short A google.com @1.1.1.1
nslookup|DNS|Query Internet name servers interactively|nslookup example.com
host|DNS|Simple DNS lookup utility|host -t mx domain.com
curl|HTTP & API|Command-line HTTP/HTTPS/FTP transfer tool with header inspection|curl -Iv https://api.github.com
wget|Downloader|Non-interactive network downloader with resume capabilities|wget -c -b https://example.com/huge.iso
http|HTTP & API|HTTPie user-friendly HTTP client with JSON syntax coloring|http POST https://api.site.com/auth user=admin
nc|Networking|Netcat arbitrary TCP and UDP connections, port scanner and listener|nc -zvw3 10.0.0.1 22 80 443
ncat|Networking|Modernized Netcat with SSL support from Nmap suite|ncat -v --ssl target.com 443
socat|Networking|Multipurpose relay tool for bidirectional data transfers and sockets|socat TCP-LISTEN:8080,fork TCP:127.0.0.1:80
tcpdump|Packet Analysis|Capture and inspect network packets directly from interface|tcpdump -i eth0 -nn -s0 -v "port 80 or port 443"
tshark|Packet Analysis|Terminal-based Wireshark network protocol analyzer|tshark -i eth0 -Y "http.request" -T fields -e http.host
iptables|Firewall|Kernel IPv4 packet filtering and NAT firewall rule administrator|iptables -L -n -v --line-numbers
iptables-save|Firewall|Dump iptables firewall rules to standard output|iptables-save > /etc/iptables.rules
ufw|Firewall|Uncomplicated Firewall management tool for Ubuntu/Debian|ufw allow 22/tcp && ufw enable
firewall-cmd|Firewall|RHEL/CentOS dynamic firewall daemon CLI tool|firewall-cmd --permanent --add-service=https && firewall-cmd --reload
nft|Firewall|Modern netfilter packet classification framework (iptables successor)|nft list ruleset
fail2ban-client|Security|Control and check status of brute-force banning jails|fail2ban-client status sshd
ssh|Remote Access|OpenSSH remote login client with private key auth and port forwarding|ssh -i ~/.ssh/id_rsa -L 8080:localhost:80 user@host
scp|File Transfer|Secure copy files over SSH protocol|scp -P 22 -r /opt/build/ user@server:/opt/app/
rsync|File Sync|Fast incremental file synchronization tool over local or SSH|rsync -avzP --delete /src/ user@remote:/dst/
sftp|File Transfer|Interactive secure file transfer program over SSH|sftp -P 22 user@server
ssh-keygen|Cryptography|Authentication key generation tool for OpenSSH (RSA, Ed25519)|ssh-keygen -t ed25519 -C "dev@company.com"
ssh-copy-id|Security|Install public SSH key on a remote server's authorized_keys|ssh-copy-id -i ~/.ssh/id_ed25519.pub user@server
sshpass|Automation|Non-interactive SSH password provider for automation scripts|sshpass -p "secret" ssh user@host
openssl|Cryptography|OpenSSL cryptographic toolkit for SSL/TLS certificates and CSR|openssl x509 -in cert.crt -text -noout
gpg|Cryptography|GNU Privacy Guard encryption, decryption, and key management|gpg --encrypt --recipient user@domain.com secret.tar
certbot|SSL/TLS|EFF Let's Encrypt automated TLS certificate provisioner|certbot --nginx -d example.com
tar|Archiving|Archive files into tarballs or extract tar.gz/bz2/xz archives|tar -xzvf archive.tar.gz -C /target/
zip|Archiving|Package and compress files into standard zip format|zip -r9 archive.zip /folder/
unzip|Archiving|Extract compressed files from ZIP archive|unzip -q archive.zip -d /destination
gzip|Compression|Compress files using gzip coding (.gz)|gzip -9 file.txt
gunzip|Compression|Decompress gzip compressed files|gunzip file.txt.gz
bzip2|Compression|High-ratio data compression tool (.bz2)|bzip2 -k file.txt
xz|Compression|Ultra high ratio data compression utility (.xz)|xz -z -9e -T0 hugefile.iso
7z|Archiving|7-Zip high compression ratio file archiver|7z a -t7z -m0=lzma2 -mx=9 archive.7z /data
docker|Containers|Build, ship, and run distributed containerized applications|docker ps -a or docker run -d --restart=always -p 80:80 nginx
docker-compose|Containers|Multi-container Docker application orchestration CLI|docker-compose up -d --build --remove-orphans
podman|Containers|Daemonless rootless container management engine (Docker replacement)|podman run -dt -p 8080:80 nginx
crictl|Containers|CLI for CRI-compatible container runtimes in Kubernetes|crictl pods
containerd|Containers|Industry-standard core container runtime daemon|ctr containers list
kubectl|Kubernetes|Kubernetes cluster management and resource control CLI|kubectl get pods -A -o wide --watch
helm|Kubernetes|The package manager for Kubernetes applications and charts|helm upgrade --install my-app ./chart --values values.yaml
k9s|Kubernetes|Terminal-based interactive UI to manage Kubernetes clusters in style|k9s
minikube|Kubernetes|Local single-node Kubernetes cluster for development|minikube start --driver=docker
kind|Kubernetes|Run local Kubernetes clusters using Docker container nodes|kind create cluster
git|Version Control|Fast distributed revision control system|git status / git commit -am "fix" / git push origin main
gh|GitHub CLI|GitHub official command-line interface for PRs and issues|gh pr create --title "feature" --body "details"
ansible|Automation|Agentless IT automation, configuration management, and deployment|ansible all -m ping -i inventory.ini
ansible-playbook|Automation|Execute Ansible playbooks to provision servers|ansible-playbook -i hosts.ini site.yml --diff
terraform|Infrastructure|Infrastructure as Code provisioning tool for cloud environments|terraform init && terraform apply -auto-approve
aws|Cloud CLI|Amazon Web Services official command line interface|aws s3 ls or aws ec2 describe-instances
az|Cloud CLI|Microsoft Azure official command line management tool|az vm list -o table
gcloud|Cloud CLI|Google Cloud Platform SDK and management CLI|gcloud compute instances list
vault|Security|HashiCorp Secret management, encryption as a service, and PAM|vault kv get secret/database
strace|Debugging|Trace system calls, file operations, and signals of a process|strace -f -tt -e trace=file,network ./binary
ltrace|Debugging|Intercept and record dynamic library calls called by process|ltrace -c ./application
valgrind|Debugging|Memory debugging, memory leak detection, and profiling tool|valgrind --leak-check=full --show-leak-kinds=all ./app
gdb|Debugging|The GNU Debugger for analyzing crashed processes and core dumps|gdb -p <PID> or gdb ./app core
perf|Profiling|Linux performance counter subsystem profiling and flamegraph tool|perf top or perf record -g -p <PID>
crontab|Automation|Schedule and manage recurring cron job tasks for user|crontab -l or crontab -e
systemd-analyze|Systemd|Profile system bootup performance and service startup time|systemd-analyze blame
logrotate|Logging|Rotates, compresses, removes, and mails system log files|logrotate -d /etc/logrotate.conf
su|Users|Switch user context or gain superuser root shell|su - username
sudo|Users|Execute commands with superuser / root privileges|sudo -u postgres psql
useradd|Users|Create a new Linux user account with home directory and shell|useradd -m -s /bin/bash -g developers devuser
usermod|Users|Modify existing user attributes or append to groups|usermod -aG sudo,docker devuser
userdel|Users|Delete user account and purge home directory|userdel -r devuser
groupadd|Users|Create a new Linux security group|groupadd -g 1500 devops
passwd|Users|Update user password and password expiry settings|passwd devuser
who|Users|Display users currently logged into system|who -a
w|Users|Show who is logged on and their current running processes|w
whoami|Users|Print current effective username|whoami
id|Users|Print real and effective user ID (UID) and group IDs (GID)|id -u devuser
last|Security Audit|Show listing of last logged in users and reboot history|last -n 25 -F
lastb|Security Audit|Show failed login attempts (detect brute force attacks)|lastb -n 20
env|Environment|Print environment variables or run command in custom env|env | grep -i path
export|Shell|Export environment variable to subshells|export APP_ENV=production
source|Shell|Execute shell commands from a file in current shell context|source ~/.bashrc
history|Shell|Display and search shell command history with timestamps|history | grep docker
xargs|Piping|Build and execute command lines from standard input streams|find . -name "*.tmp" | xargs -r rm -v
tee|Piping|Read standard input and write simultaneously to screen and file|echo "configured" | sudo tee -a /etc/sysctl.conf
watch|Monitoring|Run command repeatedly in full screen with diff highlighting|watch -d -n 1 "ss -tuln"
time|Benchmarking|Measure precision program execution duration and memory|time -v ./data_processing_script
shred|Security|Securely overwrite and purge file contents permanently|shred -u -z -n 7 sensitive.key
base64|Encoding|Encode or decode data in standard Base64 format|echo -n "user:pass" | base64
sha256sum|Integrity|Compute and verify SHA256 cryptographic hashes of files|sha256sum archive.tar.gz
md5sum|Integrity|Compute and check MD5 checksums of files|md5sum file.iso
tmux|Terminal|Terminal multiplexer with split panes, sessions, and persistence|tmux new-session -s dev
screen|Terminal|Screen manager with virtual terminal sessions|screen -rd session_name
tree|File System|Recursive visual directory listing in tree format|tree -L 3 --dirsfirst -C
jq|JSON Processing|Command-line JSON processor and filter query engine|curl -s https://api.site.com | jq '.data[0].id'
yq|YAML Processing|Command-line YAML and XML processor|yq eval '.database.host' config.yaml
redis-cli|Databases|Command line interface for Redis in-memory data store|redis-cli -h 127.0.0.1 -p 6379 PING
psql|Databases|PostgreSQL interactive database terminal client|psql -U postgres -h localhost -d mydb
mysql|Databases|MySQL and MariaDB interactive database client|mysql -u root -p -h localhost
mongosh|Databases|MongoDB interactive shell client|mongosh "mongodb://localhost:27017/db"
sqlite3|Databases|Command-line interface for SQLite database files|sqlite3 database.db "SELECT * FROM users LIMIT 5;"
nmap|Security|Network exploration tool and advanced security port scanner|nmap -sV -sC -Pn -T4 -p- 10.0.0.1
hydra|Security|Very fast network logon cracker supporting 50+ protocols|hydra -l admin -P wordlist.txt ssh://10.0.0.5
sqlmap|Security|Automated SQL injection detection and database exploitation tool|sqlmap -u "http://target.com/page?id=1" --batch --dbs
gobuster|Security|High-speed directory, DNS, vhost busting tool written in Go|gobuster dir -u http://target.com -w /wordlists/dir.txt
ffuf|Security|Ultra-fast web fuzzer written in Go|ffuf -u http://target/FUZZ -w /wordlists/common.txt
nikto|Security|Web server security scanner for dangerous files and configs|nikto -h https://target.com -ssl
masscan|Security|Internet-scale TCP port scanner, scans entire internet in minutes|masscan -p1-65535 10.0.0.0/24 --rate=5000
wireshark|Security|World standard network protocol graphical packet analyzer|wireshark
aircrack-ng|Security|802.11 WEP and WPA/WPA2 wireless security assessment suite|aircrack-ng -w wordlist.txt capture.cap
john|Security|John the Ripper password security testing and cracking tool|john --wordlist=rockyou.txt hashes.txt
hashcat|Security|World's fastest rule-based GPU accelerated password recovery tool|hashcat -m 0 -a 0 hashes.txt wordlist.txt
apt|Package Manager|Advanced Package Tool for Debian, Ubuntu, Kali Linux|apt update && apt full-upgrade -y
apt-get|Package Manager|APT legacy package manager CLI|apt-get install -y build-essential
dpkg|Package Manager|Debian package installer for .deb binaries|dpkg -i package.deb
dnf|Package Manager|Next-generation package manager for Fedora, RHEL 8+, Alma, Rocky|dnf install -y nginx
yum|Package Manager|Package manager for RHEL/CentOS 7 systems|yum install -y epel-release
pacman|Package Manager|Fast package manager for Arch Linux and Manjaro|pacman -Syu --noconfirm
zypper|Package Manager|Command line package manager for openSUSE and SLES|zypper in -y package_name
apk|Package Manager|Alpine Linux ultra-light package manager|apk add --no-cache curl bash
snap|Package Manager|Cross-distribution sandboxed software packaging system|snap install --classic code
flatpak|Package Manager|Application sandboxing framework for Linux desktops|flatpak install flathub org.mozilla.firefox
pip|Language CLI|Python package installer for PyPI libraries|pip install --upgrade requests
npm|Language CLI|Node.js package manager and registry client|npm install -g pnpm yarn
yarn|Language CLI|Fast, reliable, and secure JavaScript dependency management|yarn add express
pnpm|Language CLI|Fast, disk space efficient package manager for Node.js|pnpm add -D typescript
cargo|Language CLI|The Rust package manager and crate compilation tool|cargo build --release
go|Language CLI|Go programming language build tool and dependency manager|go build -ldflags="-s -w" -o app main.go
make|Build System|GNU Make build automation tool for software compilation|make -j$(nproc)
gcc|Compiler|GNU Compiler Collection for C programming language|gcc -O3 -Wall -Wextra main.c -o app
g++|Compiler|GNU Compiler Collection for C++ programming language|g++ -O3 -std=c++20 main.cpp -o app
clang|Compiler|LLVM-based C/C++ compiler toolchain with fast diagnostics|clang -O3 main.c -o app
cmake|Build System|Cross-platform open-source build system generator|cmake -B build -S . && cmake --build build
strace|Tracing|System call and signal interceptor for Linux binaries|strace -e openat,read,write -p <PID>
clear|Terminal|Clear the terminal display buffer|clear
reset|Terminal|Completely re-initialize and reset terminal hardware state|reset
echo|Output|Print text arguments to standard output|echo "status: active"
printf|Output|Format and print data using C standard printf syntax|printf "[%-10s] %s\n" "SUCCESS" "Service running"
read|Shell|Read a line from standard input into shell variables|read -r -s -p "Password: " pass
